{
  "name": "the-mmofps",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --experimental-sqlite packages/server/dist/server.cjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "profile:simulation": "node scripts/profile-simulation.mjs",
    "profile:realtime": "node scripts/profile-realtime.mjs",
    "profile:startup": "node scripts/profile-startup.mjs",
    "check": "npm run typecheck && npm test",
    "test:browser": "node scripts/browser-check.mjs",
    "test:entities:browser": "node --import tsx scripts/entity-browser-check.ts",
    "test:planets:browser": "node --experimental-sqlite --import tsx scripts/planetary-browser-check.ts",
    "preview": "node scripts/preview.mjs",
    "test:environment:browser": "node --experimental-sqlite --import tsx scripts/environment-browser-check.ts",
    "test:camps:browser": "node --experimental-sqlite --import tsx scripts/camp-browser-check.ts",
    "test:lighting:browser": "node --import tsx scripts/contact-lighting-browser-check.ts",
    "test:shaders:browser": "node --import tsx scripts/shader-preparation-browser-check.ts",
    "test:flora:browser": "node --experimental-sqlite --import tsx scripts/flora-browser-check.ts",
    "test:resources:browser": "node --experimental-sqlite --import tsx scripts/resource-browser-check.ts",
    "test:scenery:browser": "node --experimental-sqlite --import tsx scripts/scenery-browser-check.ts",
    "test:capture:browser": "node --experimental-sqlite --import tsx scripts/capture-browser-check.ts",
    "test:terrain:browser": "node --experimental-sqlite --import tsx scripts/terrain-browser-check.ts",
    "test:campaign:browser": "node --experimental-sqlite --import tsx scripts/campaign-browser-check.ts",
    "test:aircraft:browser": "node --experimental-sqlite --import tsx scripts/aircraft-warning-browser-check.ts",
    "test:vehicles:browser": "node --experimental-sqlite --import tsx scripts/vehicle-presence-browser-check.ts",
    "test:creatures:browser": "node --import tsx scripts/creature-model-browser-check.ts",
    "test:tactical-boss:browser": "node --experimental-sqlite --import tsx scripts/tactical-boss-browser-check.ts",
    "test:maps:browser": "node --import tsx scripts/map-readability-browser-check.ts",
    "test:orbital-campaign:browser": "node --import tsx scripts/orbital-campaign-browser-check.ts",
    "test:campaign:simulation": "node --import tsx scripts/campaign-simulation-check.ts",
    "test:campaign:realtime": "node --no-warnings --experimental-sqlite scripts/campaign-realtime-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.1",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
