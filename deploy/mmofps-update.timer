[Unit]
Description=Weekly update of THE MMOFPS (Monday 08:00 UTC)

[Timer]
# Midnight on the US West Coast, early morning in the Americas, mid-morning
# in Europe: the quietest hour for a global player base.
OnCalendar=Mon *-*-* 08:00:00 UTC
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
